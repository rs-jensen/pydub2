# clang -fsanitize=address,undefined -fsanitize-ignorelist=tests/sanitizer.ignore, only third party code is listed

# libogg adds 0 to a null buffer pointer while the sync buffer is still empty
fun:ogg_sync_pageseek
# libsamplerate compares data_out plus 0 with a null data_in
fun:src_process
# stb_vorbis puts a byte into the top of an int when it reads a page header
fun:vorbis_search_for_page_pushdata
# dr_flac adds the residual to the prediction in an int, a stream made for it overflows
[signed-integer-overflow]
src:*/dr_flac.h
